@page
@using CodieJoe.Web.Pages.Admin.ViewModels.Requests
@model CodieJoe.Web.Pages.Admin.Tag.Index

@{
    Layout = "../Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-5">
    <button class="btn btn-primary mb-3"
            data-bs-toggle="modal"
            data-bs-target="#addTagModal"
            type="button">
        + New Tag
    </button>
    <table class="table-primary">
        <thead>
        <tr>
            <th>Name</th>
            <th>Slug</th>
            <th>Posts</th>
            <th>Actions</th>
        </tr>
        </thead>

        <tbody>
        @foreach (var tag in Model.TableTags)
        {
            <tr>
                <td>@tag.Name</td>
                <td>@tag.Slug</td>
                <td>@tag.NumberOfPosts</td>
                <td>
                    <button type="button"
                            class="btn btn-sm btn-outline-primary edit-tag-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#editTagModal"
                            data-tag-id="@tag.Id"
                            data-tag-name="@tag.Name"
                            data-tag-slug="@tag.Slug">
                        Edit
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<!-- ADD MODAL-->
<div class="modal fade"
     id="addTagModal"
     tabindex="-1"
     aria-labelledby="addTagModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <form method="post"
                  asp-page="@Routes.TagsPath"
                  asp-page-handler="Create">

                <div class="modal-header">

                    <h1 class="modal-title fs-5"
                        id="addTagModalLabel">
                        Add New Tag
                    </h1>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>

                <div class="modal-body">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>

                    <div class="mb-3">

                        <label asp-for="TagAddRequestVm.Name"
                               class="form-label">
                            Tag Name
                        </label>

                        <input asp-for="TagAddRequestVm.Name"
                               class="form-control"
                               placeholder="Enter tag name"/>

                        <span asp-validation-for="TagAddRequestVm.Name"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="TagAddRequestVm.Slug"
                               class="form-label">
                            Tag Slug
                        </label>

                        <input asp-for="TagAddRequestVm.Slug"
                               class="form-control"
                               placeholder="Enter tag slug"/>

                        <span asp-validation-for="TagAddRequestVm.Slug"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Add Tag
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

<!-- EDIT MODAL-->
<div class="modal fade"
     id="editTagModal"
     tabindex="-1"
     aria-labelledby="editTagModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <form method="post"
                  asp-page-handler="Update">

                <div class="modal-header">

                    <h1 class="modal-title fs-5"
                        id="editTagModalLabel">
                        Edit Tag
                    </h1>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>

                <div class="modal-body">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>

                    <div class="mb-3">
                        <input asp-for="TagUpdateRequestVm.Id" type="hidden"/>
                        <label asp-for="TagUpdateRequestVm.Name"
                               class="form-label">
                            Tag Name
                        </label>

                        <input asp-for="TagUpdateRequestVm.Name"
                               class="form-control"
                               placeholder="Enter tag name"/>

                        <span asp-validation-for="TagUpdateRequestVm.Name"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="TagUpdateRequestVm.Slug"
                               class="form-label">
                            Tag Slug
                        </label>

                        <input asp-for="TagUpdateRequestVm.Slug"
                               class="form-control"
                               placeholder="Enter tag slug"/>

                        <span asp-validation-for="TagUpdateRequestVm.Slug"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            asp-page-handler="Delete"
                            class="btn btn-danger"
                            formnovalidate
                            >
                        Delete
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial"/>

    <script>
        document.querySelectorAll('.edit-tag-btn').forEach(button => {
            button.addEventListener('click', function () {
                document.getElementById('TagUpdateRequestVm_Id').value = this.dataset.tagId;
                document.getElementById('TagUpdateRequestVm_Name').value = this.dataset.tagName;
                document.getElementById('TagUpdateRequestVm_Slug').value = this.dataset.tagSlug;
            });
        });

        document.addEventListener('DOMContentLoaded', function () {
            @if (Model.ShowAddModal)
            {
                <text>new bootstrap.Modal(document.getElementById('addTagModal')).show();</text>
            }
            @if (Model.ShowEditModal)
            {
                <text>new bootstrap.Modal(document.getElementById('editTagModal')).show();</text>
            }
        });
    </script>
}